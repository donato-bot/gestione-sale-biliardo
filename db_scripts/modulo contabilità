// OBIETTIVO: Gestione Contabilità con Stampa PDF Multi-Pagina Ordinata e Pulita
// ==========================================
"use client";

import { useState, useEffect, useCallback } from "react";
import { supabase } from "../app/lib/supabase";

interface Transazione {
  id: string;
  descrizione: string;
  importo: number;
  tipo: 'entrata' | 'uscita';
  data_transazione: string;
}

export default function ContabilitaManager(props: any) {
  const [salaId, setSalaId] = useState<string | null>(props.salaId || props.id || null);
  const [managerEmail, setManagerEmail] = useState<string>(props.managerEmail || "");

  const [transazioni, setTransazioni] = useState<Transazione[]>([]);
  const [loading, setLoading] = useState(true);

  // Inizializzazione sul mese corrente
  const [dataDa, setDataDa] = useState(() => {
    const now = new Date();
    const y = now.getFullYear();
    const m = (now.getMonth() + 1).toString().padStart(2, '0');
    return `${y}-${m}-01`;
  });

  const [dataA, setDataA] = useState(() => {
    const now = new Date();
    const y = now.getFullYear();
    const m = (now.getMonth() + 1).toString().padStart(2, '0');
    const lastDay = new Date(y, now.getMonth() + 1, 0).getDate();
    return `${y}-${m}-${lastDay}`;
  });

  // Form Nuova Transazione
  const [descrizione, setDescrizione] = useState("");
  const [importo, setImporto] = useState("");
  const [tipo, setTipo] = useState<'entrata' | 'uscita'>("entrata");
  const [salvataggio, setSalvataggio] = useState(false);

  useEffect(() => {
    if (!salaId && typeof window !== "undefined") {
      const pathArray = window.location.pathname.split("/");
      const urlId = pathArray[pathArray.length - 1];
      if (urlId && urlId.length > 10) setSalaId(urlId);
    }
  }, [salaId]);

  const caricaContabilita = useCallback(async () => {
    if (!salaId) return;
    setLoading(true);
    try {
      let query = supabase
        .from("contabilita")
        .select("*")
        .eq("sala_id", salaId);

      if (dataDa) query = query.gte("data_transazione", dataDa);
      if (dataA) query = query.lte("data_transazione", dataA);

      const { data, error } = await query.order("data_transazione", { ascending: false });

      if (error) throw error;
      setTransazioni(data || []);
    } catch (err: any) {
      console.error("Errore contabilità:", err.message);
    } finally {
      setLoading(false);
    }
  }, [salaId, dataDa, dataA]);

  useEffect(() => {
    caricaContabilita();
  }, [caricaContabilita]);

  const handleAggiungiTransazione = async (e: React.FormEvent) => {
    e.preventDefault();
    setSalvataggio(true);

    let currentEmail = managerEmail;
    if (!currentEmail) {
      const { data } = await supabase.auth.getSession();
      currentEmail = data.session?.user?.email || "";
    }

    try {
      const importoNum = parseFloat(importo.replace(",", ".")) || 0;
      const oggi = new Date().toISOString().split("T")[0];

      const { error } = await supabase.from("contabilita").insert([{
        sala_id: salaId,
        manager_email: currentEmail,
        descrizione: descrizione.toUpperCase(),
        importo: importoNum,
        tipo: tipo,
        data_transazione: oggi
      }]);

      if (error) throw error;

      setDescrizione("");
      setImporto("");
      alert("✅ Transazione registrata con successo!");
      await caricaContabilita();
    } catch (err: any) {
      alert("Errore registrazione: " + err.message);
    } finally {
      setSalvataggio(false);
    }
  };

  const eliminaTransazione = async (id: string) => {
    if (!confirm("Sei sicuro di voler eliminare questa voce?")) return;
    try {
      const { error } = await supabase.from("contabilita").delete().eq("id", id);
      if (error) throw error;
      setTransazioni(transazioni.filter(t => t.id !== id));
    } catch (err: any) {
      alert("Errore eliminazione: " + err.message);
    }
  };

  const mostraTuttiMovimenti = async () => {
    if (!salaId) return;
    setLoading(true);
    try {
      setDataDa("");
      setDataA("");
      const { data, error } = await supabase
        .from("contabilita")
        .select("*")
        .eq("sala_id", salaId)
        .order("data_transazione", { ascending: false });

      if (error) throw error;
      setTransazioni(data || []);
    } catch (err: any) {
      console.error("Errore caricamento tutti i movimenti:", err.message);
    } finally {
      setLoading(false);
    }
  };

  const totaleEntrate = transazioni.filter(t => t.tipo === 'entrata').reduce((acc, t) => acc + t.importo, 0);
  const totaleUscite = transazioni.filter(t => t.tipo === 'uscita').reduce((acc, t) => acc + t.importo, 0);
  const saldoNetto = totaleEntrate - totaleUscite;

  const euro = new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR" });

  if (loading) return <div className="text-center p-10 text-cyan-500 font-black uppercase tracking-widest animate-pulse">Caricamento Contabilità...</div>;

  return (
    <div className="space-y-8">
      
      {/* STILI PER LA STAMPA PROFESSIONALE PULITA (PAGINA 1: RIEPILOGO, PAGINA 2: MOVIMENTI) */}
      <style>{`
        @media print {
          @page { size: portrait; margin: 15mm; }
          body { background-color: white !important; color: black !important; font-family: Arial, sans-serif; font-size: 11pt; -webkit-print-color-adjust: exact; }
          .no-print { display: none !important; }
          
          /* Nascondi la plancia e i bordi scuri del sito */
          .print-container { background: white !important; border: none !important; box-shadow: none !important; padding: 0 !important; }
          
          /* Pagina 1: Intestazione e Box Riepilogo */
          .print-page-1 {
            page-break-after: always;
            break-after: page;
          }
          
          .print-header-title {
            font-size: 20pt !important;
            font-weight: 900 !important;
            color: black !important;
            text-transform: uppercase;
            border-bottom: 3px solid black;
            padding-bottom: 10px;
            margin-bottom: 25px;
          }

          .print-summary-box {
            border: 2px solid #334155 !important;
            background: #f8fafc !important;
            padding: 20px !important;
            border-radius: 12px !important;
            margin-bottom: 15px !important;
          }

          /* Pagina 2: Tabella Storico Movimenti */
          .print-page-2 {
            page-break-before: always;
            break-before: page;
          }

          table { width: 100% !important; border-collapse: collapse !important; margin-top: 10px; }
          th { background-color: #0f172a !important; color: white !important; font-size: 10pt; padding: 10px; text-transform: uppercase; text-align: left; }
          td { border-bottom: 1px solid #cbd5e1 !important; color: black !important; padding: 10px; font-size: 10pt; }
        }
      `}</style>

      {/* CONTENITORE PRINCIPALE (Aree separate per la stampa) */}
      <div className="space-y-8 print-container">

        {/* PAGINA 1: INTESTAZIONE E RIEPILOGO FINANZIARIO */}
        <div className="print-page-1 space-y-6">
          {/* HEADER WEB & STAMPA */}
          <div className="bg-[#111827] border border-gray-700/70 p-6 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-4 print-container">
            <div>
              <h2 className="text-xl font-black uppercase tracking-widest text-emerald-400 print-header-title">Registro Contabilità & Cassa</h2>
              <p className="text-xs text-gray-400 uppercase tracking-widest no-print">Filtra per periodo ed esporta il report</p>
            </div>

            {/* FILTRI PERIODO */}
            <div className="flex items-center gap-3 no-print">
              <div>
                <label className="block text-[9px] text-gray-400 font-black uppercase tracking-widest mb-1">Dal:</label>
                <input 
                  type="date" 
                  value={dataDa} 
                  onChange={e => setDataDa(e.target.value)}
                  onClick={(e) => { try { (e.currentTarget as HTMLInputElement).showPicker?.(); } catch {} }}
                  className="bg-[#1e293b] border border-cyan-500/50 text-white text-xs p-2.5 rounded-xl focus:outline-none uppercase font-mono cursor-pointer"
                />
              </div>
              <div>
                <label className="block text-[9px] text-gray-400 font-black uppercase tracking-widest mb-1">Al:</label>
                <input 
                  type="date" 
                  value={dataA} 
                  onChange={e => setDataA(e.target.value)}
                  onClick={(e) => { try { (e.currentTarget as HTMLInputElement).showPicker?.(); } catch {} }}
                  className="bg-[#1e293b] border border-cyan-500/50 text-white text-xs p-2.5 rounded-xl focus:outline-none uppercase font-mono cursor-pointer"
                />
              </div>
              <button 
                type="button"
                onClick={mostraTuttiMovimenti}
                className="mt-5 bg-gray-800 hover:bg-gray-700 text-gray-200 px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-600 transition-colors shadow-md"
              >
                Tutti
              </button>

              <button 
                type="button"
                onClick={() => window.print()}
                className="mt-5 bg-cyan-600 hover:bg-cyan-500 text-black font-black px-5 py-3 rounded-xl text-xs uppercase tracking-widest transition-all shadow-lg flex items-center gap-2"
              >
                🖨️ Stampa / PDF
              </button>
            </div>
          </div>
          
          {/* BOX RIEPILOGO FINANZIARIO */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div className="bg-[#111827] border border-gray-700/70 p-6 rounded-2xl shadow-xl border-l-4 border-l-emerald-500 print-summary-box">
              <p className="text-[10px] font-black uppercase tracking-widest text-gray-400 print:text-gray-600">Entrate Totali</p>
              <p className="text-3xl font-black text-emerald-400 mt-2 font-mono print:text-black">{euro.format(totaleEntrate)}</p>
            </div>
            <div className="bg-[#111827] border border-gray-700/70 p-6 rounded-2xl shadow-xl border-l-4 border-l-red-500 print-summary-box">
              <p className="text-[10px] font-black uppercase tracking-widest text-gray-400 print:text-gray-600">Uscite / Spese</p>
              <p className="text-3xl font-black text-red-400 mt-2 font-mono print:text-black">{euro.format(totaleUscite)}</p>
            </div>
            <div className="bg-[#111827] border border-gray-700/70 p-6 rounded-2xl shadow-xl border-l-4 border-l-cyan-500 print-summary-box">
              <p className="text-[10px] font-black uppercase tracking-widest text-gray-400 print:text-gray-600">Saldo Netto in Cassa</p>
              <p className={`text-3xl font-black mt-2 font-mono print:text-black ${saldoNetto >= 0 ? 'text-cyan-400' : 'text-red-400'}`}>{euro.format(saldoNetto)}</p>
            </div>
          </div>
        </div>

        {/* INTERFACCIA WEB (Form inserimento - Nascosta in stampa) */}
        <div className="no-print">
          <div className="bg-[#111827] border border-gray-700/70 border-t-4 border-t-cyan-500 rounded-2xl shadow-2xl shadow-black/60 p-6 max-w-md">
            <h2 className="text-lg font-black uppercase tracking-widest text-cyan-400 mb-6">Registra Movimento</h2>
            
            <form onSubmit={handleAggiungiTransazione} className="space-y-4">
              <div>
                <label className="block text-[10px] text-gray-400 font-black uppercase tracking-widest mb-1.5">Tipo Operazione</label>
                <div className="grid grid-cols-2 gap-3">
                  <button
                    type="button"
                    onClick={() => setTipo('entrata')}
                    className={`py-3 rounded-xl font-black text-xs uppercase tracking-widest transition-all ${tipo === 'entrata' ? 'bg-emerald-600 text-white shadow-lg' : 'bg-[#1e293b] text-gray-400 border border-gray-700'}`}
                  >
                    + Entrata
                  </button>
                  <button
                    type="button"
                    onClick={() => setTipo('uscita')}
                    className={`py-3 rounded-xl font-black text-xs uppercase tracking-widest transition-all ${tipo === 'uscita' ? 'bg-red-600 text-white shadow-lg' : 'bg-[#1e293b] text-gray-400 border border-gray-700'}`}
                  >
                    - Uscita
                  </button>
                </div>
              </div>

              <div>
                <label className="block text-[10px] text-gray-400 font-black uppercase tracking-widest mb-1.5">Descrizione *</label>
                <input 
                  type="text" 
                  required
                  placeholder="Es. Incasso Tavoli / Bolletta Luce"
                  value={descrizione} 
                  onChange={(e) => setDescrizione(e.target.value)} 
                  className="w-full bg-[#1e293b] border-2 border-gray-700 p-3 rounded-xl text-white font-bold text-xs uppercase focus:outline-none focus:border-cyan-500 transition-colors" 
                />
              </div>

              <div>
                <label className="block text-[10px] text-gray-400 font-black uppercase tracking-widest mb-1.5">Importo (€) *</label>
                <input 
                  type="text" 
                  required
                  placeholder="Es. 50.00"
                  value={importo} 
                  onChange={(e) => setImporto(e.target.value)} 
                  className="w-full bg-[#1e293b] border-2 border-gray-700 p-3 rounded-xl text-cyan-400 font-black text-xs focus:outline-none focus:border-cyan-500 transition-colors" 
                />
              </div>

              <button 
                type="submit" 
                disabled={salvataggio}
                className="w-full bg-cyan-600 hover:bg-cyan-500 disabled:bg-gray-800 text-black font-black uppercase tracking-widest py-4 rounded-xl text-xs transition-all shadow-lg mt-6"
              >
                {salvataggio ? "REGISTRAZIONE..." : "REGISTRA MOVIMENTO"}
              </button>
            </form>
          </div>
        </div>

        {/* PAGINA 2: TABELLA STORICO MOVIMENTI DI CASSA */}
        <div className="print-page-2">
          <div className="bg-[#111827] border border-gray-700/70 border-t-4 border-t-emerald-500 rounded-2xl shadow-2xl shadow-black/60 overflow-hidden print-container">
            <div className="p-6 border-b border-gray-700/50 bg-[#0b0e14]/50 flex justify-between items-center print-container">
              <h2 className="text-lg font-black uppercase tracking-widest text-emerald-400 print:text-black print:text-xl print:font-bold">Storico Movimenti di Cassa</h2>
              <span className="bg-emerald-900/30 text-emerald-400 border border-emerald-800/50 px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-widest no-print">
                {transazioni.length} Voci
              </span>
            </div>
            
            <div className="p-6 overflow-x-auto print:p-0">
              <table className="w-full text-left border-collapse">
                <thead>
                  <tr className="border-b border-gray-800 text-[10px] text-gray-400 font-black uppercase tracking-widest">
                    <th className="pb-3">Data</th>
                    <th className="pb-3">Descrizione</th>
                    <th className="pb-3 text-center">Tipo</th>
                    <th className="pb-3 text-right">Importo</th>
                    <th className="pb-3 text-right no-print">Azioni</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-800/50">
                  {transazioni.length === 0 ? (
                    <tr>
                      <td colSpan={5} className="text-center py-10 text-gray-500 uppercase tracking-widest text-xs font-bold">
                        Nessun movimento registrato nel periodo selezionato.
                      </td>
                    </tr>
                  ) : (
                    transazioni.map(t => (
                      <tr key={t.id} className="hover:bg-[#1e293b]/50 transition-colors">
                        <td className="py-4 text-xs font-mono text-gray-400 print:text-black">{t.data_transazione}</td>
                        <td className="py-4 text-white font-black uppercase text-sm tracking-wider print:text-black">{t.descrizione}</td>
                        <td className="py-4 text-center">
                          <span className={`px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-widest ${t.tipo === 'entrata' ? 'text-emerald-600 print:text-black font-bold' : 'text-red-600 print:text-black font-bold'}`}>
                            {t.tipo}
                          </span>
                        </td>
                        <td className={`py-4 text-right font-mono font-bold ${t.tipo === 'entrata' ? 'text-emerald-400 print:text-black' : 'text-red-400 print:text-black'}`}>
                          {t.tipo === 'entrata' ? '+' : '-'}{euro.format(t.importo)}
                        </td>
                        <td className="py-4 text-right no-print">
                          <button 
                            type="button"
                            onClick={() => eliminaTransazione(t.id)}
                            className="text-gray-500 hover:text-red-400 text-xs font-black uppercase tracking-widest border border-gray-700 hover:border-red-500/30 rounded-lg px-3 py-1.5 bg-[#0b0e14] transition-colors"
                          >
                            Elimina
                          </button>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  );
}